{
  "version": 2,
  "notes": "All sizes and offsets are in art pixels. Sprites face right; the app flips them for left. Draw at integer scales with image-rendering: pixelated.",
  "states": {
    "walk": {
      "frames": ["walk/walk_0.png", "walk/walk_1.png", "walk/walk_2.png", "walk/walk_3.png"],
      "frameMs": 140,
      "size": [63, 58],
      "note": "default walk, wearing the news satchel"
    },
    "walk_nobag": {
      "frames": ["walk_nobag/walk_nobag_0.png", "walk_nobag/walk_nobag_1.png", "walk_nobag/walk_nobag_2.png", "walk_nobag/walk_nobag_3.png"],
      "frameMs": 140,
      "size": [63, 58],
      "note": "optional: after he sets the bag down"
    },
    "loaf": {
      "frames": ["loaf/loaf_idle_a.png", "loaf/loaf_idle_b.png"],
      "frameMs": 900,
      "size": [63, 42],
      "extras": [
        { "name": "blink", "frame": "loaf/loaf_blink.png", "showMs": 120, "everyMs": [3000, 6000] },
        { "name": "tail_flick", "frame": "loaf/loaf_tail_flick.png", "showMs": 300, "everyMs": [8000, 15000] }
      ]
    },
    "sleep": {
      "frames": ["sleep/sleep_0.png", "sleep/sleep_1.png"],
      "frameMs": 1400,
      "size": [63, 42],
      "zzz": {
        "frames": ["fx/z_0.png", "fx/z_1.png", "fx/z_2.png"],
        "origin": [56, 6],
        "riseMs": 2400,
        "risePx": 18,
        "driftPx": 6,
        "count": 2,
        "stepMs": 200,
        "note": "z's rise from above the head (head is on the right), growing z_0 -> z_2"
      }
    }
  },
  "sequences": {
    "wake_on_click": {
      "steps": [
        { "frame": "loaf/loaf_half_eyes.png", "ms": 150, "y": 0 },
        { "frame": "loaf/loaf_idle_a.png", "ms": 100, "y": -5 },
        { "frame": "walk/walk_0.png", "ms": 100, "y": -3 },
        { "frame": "walk/walk_0.png", "ms": 160, "y": 0 }
      ],
      "paperToss": {
        "frame": "fx/paper_roll.png",
        "maxRolls": 3,
        "staggerMs": 140,
        "flightMs": 520,
        "arcHeightPx": 22,
        "distancePx": [28, 46],
        "note": "rolls arc away from the pile; the pile loses layers evenly so it is empty after the last roll; then return to walk"
      }
    }
  },
  "pile": {
    "files": ["pile/pile_1.png", "pile/pile_2.png", "pile/pile_3.png", "pile/pile_4.png", "pile/pile_5.png"],
    "width": 56,
    "layerHeight": 8,
    "basePad": 2,
    "offsetX": 4,
    "catOverlap": 1,
    "unreadToLayers": [
      { "minUnread": 1, "layers": 1 },
      { "minUnread": 3, "layers": 2 },
      { "minUnread": 5, "layers": 3 },
      { "minUnread": 7, "layers": 4 },
      { "minUnread": 9, "layers": 5 }
    ]
  },
  "behavior": {
    "sleepAfterEditions": 2,
    "walkStepPx": 2,
    "walkStepMs": 140,
    "note": "sleep when the oldest unread edition is more than sleepAfterEditions editions old. Walk moves walkStepPx every walkStepMs; one step per walk frame keeps redraws (and CPU) down."
  },
  "palette": {
    "outline": "#3b2630",
    "body": "#d3935f",
    "stripe": "#b25c36",
    "cream": "#edddb8",
    "cap": "#4b5163"
  }
}
